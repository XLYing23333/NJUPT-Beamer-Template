% Scale font sizes and line spacing inside ordinary frames.
% Special pages set this flag locally before starting their frame.
\newif\ifcollegebeamer@specialframe
\let\collegebeamerSpecialFrame\collegebeamer@specialframetrue
\newcommand{\setbeamerzoom}[1]{%
  \pgfmathparse{#1}%
  \ifdim\pgfmathresult pt>0pt\relax
    \xdef\collegebeamer@zoom{\pgfmathresult}%
  \else
    \PackageError{collegeBeamer}{Zoom factor must be positive}{Use a positive number, such as 0.8.}%
  \fi
}
\def\collegebeamer@zoom{1}
\newcommand{\collegebeamer@applyzoom}{%
  \ifcollegebeamer@specialframe\else
    \let\collegebeamer@setfontsize\@setfontsize
    \def\@setfontsize##1##2##3{%
      \@defaultunits\@tempdima=##2pt\relax\@nnil
      \@defaultunits\@tempdimb=##3pt\relax\@nnil
      \@tempdima=\collegebeamer@zoom\@tempdima
      \@tempdimb=\collegebeamer@zoom\@tempdimb
      \collegebeamer@setfontsize##1{\the\@tempdima}{\the\@tempdimb}%
    }%
    % Keep Chinese text and list items legible at each zoom level.
    \linespread{1.15}%
    \normalsize
    \parskip=0.3em\relax
    \let\collegebeamer@listi\@listi
    \let\collegebeamer@listii\@listii
    \let\collegebeamer@listiii\@listiii
    \def\@listi{\collegebeamer@listi\itemsep=0.35em\relax}%
    \let\@listI\@listi
    \def\@listii{\collegebeamer@listii\itemsep=0.25em\relax}%
    \def\@listiii{\collegebeamer@listiii\itemsep=0.2em\relax}%
  \fi
}

\patchcmd{\beamer@frameslide}{\beamer@inframetrue}{\beamer@inframetrue\collegebeamer@applyzoom}{}{\PackageError{collegeBeamer}{Cannot install frame zoom}{}}

% Grouped double-rule table style.
\newenvironment{BNUtable}[2][\linewidth]{%
  \begingroup\small
  \setlength{\tabcolsep}{5pt}%
  \setlength{\arrayrulewidth}{0.5pt}%
  \renewcommand{\arraystretch}{1.65}%
  \setlength{\aboverulesep}{0pt}%
  \setlength{\belowrulesep}{0pt}%
  \tabularx{#1}{#2}%
}{\endtabularx\endgroup}
\newcommand{\BNUtoprule}{\specialrule{1.5pt}{0pt}{0.7pt}\specialrule{0.5pt}{0pt}{0pt}}
\newcommand{\BNUmidrule}{\midrule[0.7pt]}
\newcommand{\BNUbottomrule}{\specialrule{0.5pt}{0pt}{0.7pt}\specialrule{1.5pt}{0pt}{0pt}}

% Reusable PGFPlots styling for charts on ordinary frames.
\let\NJUPTtable\BNUtable
\let\endNJUPTtable\endBNUtable
\let\NJUPTtoprule\BNUtoprule
\let\NJUPTmidrule\BNUmidrule
\let\NJUPTbottomrule\BNUbottomrule

\pgfplotscreateplotcyclelist{bnucolors}{%
  {maincolor,mark=*},
  {airforceblue,mark=square*},
  {orange!80!black,mark=triangle*},
  {teal!70!black,mark=diamond*}
}
\pgfplotsset{bnu chart/.style={
  width=0.88\linewidth,height=0.58\paperheight,
  axis line style={gray!70},tick style={gray!70},
  grid=major,grid style={gray!20},
  tick label style={font=\scriptsize},label style={font=\small},
  legend style={font=\scriptsize,draw=none,fill=none},
  cycle list name=bnucolors
}}
\pgfplotsset{njupt chart/.style={bnu chart}}

% --- section & frame setting ---
% subsection
\newcommand{\strsubsec}{Section \thesection.\thesubsection}

% presents subtitle on each frame
\makeatletter
    \pretocmd\beamer@checkframetitle{\ifnum\value{section}>0\relax\framesubtitle{\thesection \, \secname}\fi}
\makeatother

% avoid numbering of frames that are breaked into multiply slides
\setbeamertemplate{frametitle continuation}{}

% section page with the current section highlighted
\AtBeginSection[]
{
    \begingroup
    \collegebeamerSpecialFrame
    \setbeamertemplate{footline}{}
    \themecolor{colorbg}
    \begin{frame}{\tocStr}
        \tableofcontents[currentsection]
    \end{frame}
    \endgroup
}

% subsection title page
\AtBeginSubsection[]
{
    \begingroup
    \collegebeamerSpecialFrame
    \begin{frame}{\,}{\thesection \, \secname}
        \fontfamily{ptm}\selectfont
        \centering\textsl{\textbf{\textcolor{maincolor}{
            \large Section \thesection.\thesubsection
            \vskip15pt
            \LARGE \subsecname
        }}}
    \end{frame}
    \endgroup
}

% --- page elements ---
% frame title & subtitle layout
\setbeamertemplate{frametitle}{
    \vspace*{-4.6ex}
    \begin{beamercolorbox}[leftskip=2cm]{frametitle}
    \usebeamerfont{frametitle}\insertframetitle\\
    \vskip5pt
    \usebeamerfont{framesubtitle}\insertframesubtitle
    \end{beamercolorbox}
}

% title page
\setbeamertemplate{title page}{
    \vspace{1.5cm}
    \hspace{-12mm}  % pull back the box in an inelegant way - but it works!
    \begin{beamercolorbox}[wd=0.9\textwidth, sep=10pt, leftskip=8mm]{title}
        {\usebeamerfont{title}\inserttitle}\\
        \vskip5pt{\usebeamerfont{subtitle}\insertsubtitle}\\
        \vskip5pt{\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor}\\
        \vskip5pt{\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate}
    \end{beamercolorbox}
}

\renewcommand{\maketitle}{
    \begingroup
        \collegebeamerSpecialFrame
        \collegebeamerTitleHeadline
        \setbeamertemplate{footline}{}
        \setbeamertemplate{background}{
          \includegraphics[height=\paperheight]{\backgroundPath}
        }
        \begin{frame}
            \titlepage
        \end{frame}
    \endgroup
}

% Q&A page
\newcommand{\QApage}{
    \begingroup
        \collegebeamerSpecialFrame
        \setbeamertemplate{footline}{}
        \themecolor{colorbg}
        
        \begin{frame}{}
            \centering
            \begin{minipage}{\textwidth}
                \usebeamercolor[fg]{normal text}
                \centering
                \Huge $$\mathcal Thanks$$
                \Large \qaStr
            \end{minipage}
        \end{frame}
    \endgroup
}

% bibliography page
\newcommand{\bibliographpage}{
    \section{References}

    \begingroup
    \collegebeamerSpecialFrame
    \themecolor{colorbg}
    \begin{frame}[allowframebreaks]{References}{\,}
        \tiny
        \printbibliography[heading=none]
    \end{frame}
\endgroup
}

